{
  "expo": {
    "name": "NEWBIZZ",
    "slug": "newbizz",
    "scheme": "newbizz",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.newbizz.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.newbizz.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0891b2"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow NEWBIZZ to scan store QR codes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0891b2",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow NEWBIZZ to record visit locations."
        }
      ],
      "expo-splash-screen"
    ],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
