# NEWBIZZ app environment — copy to .env.local and fill in
# Supabase project settings → API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (never expose to the browser). Used by migrations / server actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.YOUR-PROJECT.supabase.co:5432/postgres

# Business locale
APP_TIMEZONE=Asia/Kolkata
APP_DEFAULT_LOCALE=en

# Shared secret guarding the cron fallback endpoints (/api/cron/notifications,
# /api/intangles/poll). Set the same value in Vercel env; the endpoint rejects
# requests that don't carry it as a Bearer token.
CRON_SECRET=change-me
