# ---------------------------------------------------------------------
# NEWBIZZ — Next.js environment (copy to .env.local and fill / keep as-is)
#
# These two are PUBLIC (safe to ship to the browser). The publishable key
# is RLS-scoped: it can only do what the signed-in user's policies allow.
# The DB (RLS + SECURITY DEFINER RPCs) is the only security boundary.
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://wmpxwpubfxpexybqnynz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_dhKtU7rftb0tw0z10g7BBg_IXDq6n_4

# ---------------------------------------------------------------------
# Server-only secrets — never expose to the browser.
# ---------------------------------------------------------------------
# Privileged client for the server infra (WhatsApp webhook receiver, cron
# routes, the WhatsApp dispatch worker and the Intangles poller). This key
# CANNOT be read from the browser by anyone without the Vercel env; it fails
# closed if unset (refuses to downgrade to the anon key). Get it from:
# Supabase Dashboard -> Project Settings -> API -> service_role key
# (NEW: legacy "JWT" secret, or "Publishable" keys are NOT service role.)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Default country code for phone-OTP login (India). The login screen shows this
# as a fixed prefix; users type the 10 national digits.
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=91

# ---------------------------------------------------------------------
# Server-only secrets — never expose to the browser.
# ---------------------------------------------------------------------
# Shared secret guarding cron fallback endpoints (/api/cron/notifications,
# /api/intangles/poll). Requests without `Authorization: Bearer <value>`
# are rejected. Keep it long and random, and set the same value in Vercel.
CRON_SECRET=change-me-long-random-string
